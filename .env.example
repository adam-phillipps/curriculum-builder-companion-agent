# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here
LOG_LEVEL=DEBUG  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=curriculum_builder
POSTGRES_USER=curriculum_user
POSTGRES_PASSWORD=curriculum_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# AI Models
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# AWS (optional for development)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-west-2

# Agent Configuration
AGENT_TEMPERATURE=0.7
AGENT_MODEL=gpt-4
HUMAN_REVIEW_REQUIRED=true
SIMILARITY_THRESHOLD=0.85
MAX_RETRIES=3
TIMEOUT_SECONDS=300

# Embeddings
EMBEDDING_MODEL=text-embedding-ada-002
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# CORS Configuration
# APP_ENV=development automatically allows all origins for local dev
# APP_ENV=production uses pattern-based validation
# No manual configuration needed - works automatically with CloudFront/ALB